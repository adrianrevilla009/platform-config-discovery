{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "express-checkout": {
      "state": "ENABLED",
      "variants": { "on": true, "off": false },
      "defaultVariant": "off",
      "targeting": {
        "if": [{ "ends_with": [{ "var": "email" }, "@example.com"] }, "on", "off"]
      }
    }
  }
}
